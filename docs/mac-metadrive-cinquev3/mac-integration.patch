+import numpy as np
+
+from openpilot.selfdrive.modeld.compile_modeld import (
+  make_stateful_input_queues,
+  stateful_host_shapes,
+  stateful_image_shapes,
+)
+
+
+def _metadata():
+  input_shapes = {
+    "new_img": (2, 6, 128, 256),
+    "desire": (1, 8),
+    "traffic_convention": (1, 2),
+    "action_t": (1, 2),
+    "state_img_q": (2, 6, 128, 256),
+    "state_desire_q": (1, 5, 8),
+    "state_feat_q": (1, 5, 16),
+  }
+  state_pairs = {
+    "state_img_q": "next_state_img_q",
+    "state_desire_q": "next_state_desire_q",
+    "state_feat_q": "next_state_feat_q",
+  }
+  return {
+    "input_shapes": input_shapes,
+    "input_dtypes": {name: "uint8" if name in ("new_img", "state_img_q") else "float32" for name in input_shapes},
+    "output_shapes": {next_name: input_shapes[name] for name, next_name in state_pairs.items()},
+    "state_pairs": state_pairs,
+  }
+
+
+def test_stateful_queue_builder_separates_model_state_from_camera_warp_inputs():
+  metadata = _metadata()
+  queues, npy = make_stateful_input_queues(metadata, "CPU")
+
+  assert stateful_image_shapes(metadata) == {
+    "img": (1, 6, 128, 256),
+    "big_img": (1, 6, 128, 256),
+  }
+  assert set(stateful_host_shapes(metadata)) == {"desire", "traffic_convention", "action_t"}
+  assert set(queues) == {
+    "packed_npy_inputs", "tfm", "big_tfm",
+    "state_img_q", "state_desire_q", "state_feat_q",
+  }
+  assert npy["tfm"].shape == (3, 3)
+  assert npy["big_tfm"].shape == (3, 3)
+  assert np.dtype(queues["state_img_q"].dtype.fmt) == np.dtype(np.uint8)
+  assert np.dtype(queues["state_desire_q"].dtype.fmt) == np.dtype(np.float32)
+  assert np.isfinite(npy["desire"]).all()
