diff --git a/selfdrive/modeld/jetlink_coreml.py b/selfdrive/modeld/jetlink_coreml.py
new file mode 100644
--- /dev/null
+++ b/selfdrive/modeld/jetlink_coreml.py
@@ -0,0 +1,186 @@
+"""Local Jetlink/CoreML runner for stateful Cinque ONNX simulation inference."""
+
+from __future__ import annotations
+
+import atexit
+import hashlib
+import json
+import logging
+import os
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+import numpy as np
+
+LOG = logging.getLogger(__name__)
+_SERVER_LOCK = threading.Lock()
+_SERVER_PROCESS: subprocess.Popen | None = None
+
+
+def _model_identity(path: Path) -> tuple[str, int]:
+  digest = hashlib.sha256()
+  size = 0
+  with path.open("rb") as model_file:
+    for block in iter(lambda: model_file.read(4 * 1024 * 1024), b""):
+      digest.update(block)
+      size += len(block)
+  return digest.hexdigest(), size
+
+
+def _connect(host: str, port: int):
+  try:
+    from jetlink.client import JetlinkClient
+  except ImportError as e:
+    raise RuntimeError("CoreML simulation inference needs optional dependencies; run `uv sync --extra simulation-coreml`") from e
+
+  global _SERVER_PROCESS
+  try:
+    return JetlinkClient.open_tcp(host, port)
+  except OSError:
+    if host not in {"127.0.0.1", "localhost", "::1"}:
+      raise RuntimeError(f"No Jetlink CoreML server listening at {host}:{port}") from None
+
+  preload_marker: Path | None = None
+  with _SERVER_LOCK:
+    if _SERVER_PROCESS is None or _SERVER_PROCESS.poll() is not None:
+      cache_dir = Path(os.getenv(
+        "SIMULATION_COREML_CACHE",
+        Path.home() / "Library" / "Caches" / "openpilot" / "jetlink",
+      )).expanduser()
+      cache_dir.mkdir(parents=True, exist_ok=True)
+      preload_marker = cache_dir / "last-loaded.json"
+      command = [
+        sys.executable, "-m", "jetlink.server.main",
+        "--backend", "ort", "--device", "ane", "--transport", "tcp",
+        "--host", host, "--port", str(port), "--cache", str(cache_dir),
+        "--parent-pid", str(os.getpid()),
+      ]
+      _SERVER_PROCESS = subprocess.Popen(command, stdin=subprocess.DEVNULL)
+      LOG.info("Started local Jetlink CoreML server on %s:%s", host, port)
+
+  deadline = time.monotonic() + 60
+  last_error: OSError | None = None
+  while time.monotonic() < deadline:
+    if _SERVER_PROCESS is not None and _SERVER_PROCESS.poll() is not None:
+      raise RuntimeError(f"Local Jetlink server exited with status {_SERVER_PROCESS.returncode}")
+    try:
+      client = JetlinkClient.open_tcp(host, port)
+      if preload_marker is not None:
+        try:
+          _wait_for_local_preload(client, preload_marker)
+        except BaseException:
+          client.close()
+          raise
+      return client
+    except OSError as e:
+      last_error = e
+      time.sleep(0.1)
+  raise RuntimeError(f"Local Jetlink server did not listen on {host}:{port} within 60 seconds") from last_error
+
+
+def _wait_for_local_preload(client, marker: Path) -> None:
+  """Finish a newly spawned server's remembered preload before requesting a new model.
+
+  Jetlink 40d7507 can answer ENGINE_REQ with "building" for a different
+  startup preload, then transition to "need_upload". Its client only uploads
+  on the initial response, so requesting during that preload stalls forever.
+  This waits only for our newly spawned local server, never an external job.
+  """
+  try:
+    remembered = json.loads(marker.read_text())["sha256"]
+  except (OSError, ValueError, KeyError, TypeError):
+    return
+  hello = client.hello()
+  if remembered not in hello.get("cached_models", []) or hello.get("loaded") is not None:
+    return
+  LOG.info("Waiting for local Jetlink startup preload %s", remembered[:16])
+  deadline = time.monotonic() + 30
+  while time.monotonic() < deadline:
+    if client.state().get("loaded") is not None:
+      return
+    time.sleep(0.1)
+  raise RuntimeError("Local Jetlink startup preload did not finish within 30 seconds")
+
+
+class StatefulJetlinkCoreML:
+  """Run stateful V3 inference through Jetlink's ANE-vision/GPU-policy path."""
+
+  def __init__(self, model_path: str | Path, model_metadata: dict,
+               packed_shapes: dict[str, tuple[int, ...]], output_slices: dict[str, slice]):
+    if sys.platform != "darwin":
+      raise RuntimeError("SIMULATION_COREML_MODEL is only supported on macOS")
+
+    self.model_path = Path(model_path).expanduser().resolve(strict=True)
+    self.sha256, self.nbytes = _model_identity(self.model_path)
+    self.frame_id = 0
+    self.reset_pending = True
+
+    host = os.getenv("SIMULATION_COREML_HOST", "127.0.0.1")
+    port = int(os.getenv("SIMULATION_COREML_PORT", "5599"))
+    self.client = _connect(host, port)
+    try:
+      atexit.register(self.client.close)
+      hello = self.client.hello()
+      if hello.get("backend") != "ort" or not str(hello.get("device", "")).startswith("ane-"):
+        raise RuntimeError(f"Expected Jetlink ORT/ANE server, got backend={hello.get('backend')!r}, device={hello.get('device')!r}")
+      spec = self.client.ensure_engine(
+        self.sha256,
+        self.nbytes,
+        onnx_path=self.model_path,
+        frame_skip=1,
+        build_timeout=900,
+      )
+      if not spec.stateful:
+        raise ValueError("The selected ONNX is not a stateful model (missing new_img input)")
+      expected_shapes = {name: tuple(shape) for name, shape in model_metadata["input_shapes"].items()}
+      for name, shape in expected_shapes.items():
+        if spec.input_shapes.get(name) != shape:
+          raise ValueError(f"Jetlink input ABI mismatch for {name}: {spec.input_shapes.get(name)} != {shape}")
+      expected_states = dict(model_metadata["state_pairs"])
+      if spec.state_pairs != expected_states:
+        raise ValueError(f"Jetlink state ABI mismatch: {spec.state_pairs} != {expected_states}")
+      expected_packed = {name: tuple(shape) for name, shape in packed_shapes.items()}
+      actual_packed = {name: tuple(shape) for name, shape in spec.packed_shapes.items()}
+      if list(actual_packed.items()) != list(expected_packed.items()):
+        raise ValueError(f"Jetlink packed-input ABI mismatch: {actual_packed} != {expected_packed}")
+      if spec.output_slices != output_slices:
+        raise ValueError("Jetlink output slices do not match the modeld artifact")
+    except BaseException:
+      atexit.unregister(self.client.close)
+      self.client.close()
+      raise
+
+    self.spec = spec
+    LOG.info(
+      "Cinque CoreML ready via Jetlink: model=%s hash=%s inputs=%d outputs=%d",
+      self.model_path.name, self.sha256[:16], len(spec.input_shapes), spec.output_nelem,
+    )
+
+  def reset(self) -> None:
+    self.reset_pending = True
+
+  def run(self, warped: np.ndarray, packed: np.ndarray) -> np.ndarray:
+    warped = np.asarray(warped)
+    if warped.dtype != np.uint8 or warped.shape != self.spec.warped_shape:
+      raise ValueError(
+        f"Warp ABI mismatch: expected uint8 {self.spec.warped_shape}, got {warped.dtype} {warped.shape}"
+      )
+    packed = np.ascontiguousarray(packed, dtype=np.float32).reshape(-1)
+    if packed.size != self.spec.packed_nelem:
+      raise ValueError(f"Packed inputs have {packed.size} floats; expected {self.spec.packed_nelem}")
+
+    result = self.client.infer(
+      np.ascontiguousarray(warped),
+      packed,
+      frame_id=self.frame_id,
+      reset=self.reset_pending,
+    )
+    self.frame_id += 1
+    self.reset_pending = False
+    result = np.asarray(result, dtype=np.float32).reshape(-1)
+    if result.size != self.spec.output_nelem or not np.isfinite(result).all():
+      raise ValueError(f"Jetlink returned invalid model output: shape={result.shape}")
+    return result
diff --git a/selfdrive/modeld/tests/test_jetlink_coreml_startup.py b/selfdrive/modeld/tests/test_jetlink_coreml_startup.py
new file mode 100644
--- /dev/null
+++ b/selfdrive/modeld/tests/test_jetlink_coreml_startup.py
@@ -0,0 +1,54 @@
+import json
+
+import pytest
+
+from openpilot.selfdrive.modeld.jetlink_coreml import _wait_for_local_preload
+
+
+class PreloadClient:
+  def __init__(self, hello, states=()):
+    self.hello_value = hello
+    self.states = iter(states)
+    self.state_calls = 0
+
+  def hello(self):
+    return self.hello_value
+
+  def state(self):
+    self.state_calls += 1
+    return next(self.states)
+
+
+def test_waits_for_remembered_preload_before_model_switch(tmp_path, monkeypatch):
+  marker = tmp_path / "last-loaded.json"
+  marker.write_text(json.dumps({"sha256": "stock-sha"}))
+  client = PreloadClient({"loaded": None, "cached_models": ["stock-sha"]},
+                         [{"loaded": None}, {"loaded": "stock-sha"}])
+  monkeypatch.setattr("openpilot.selfdrive.modeld.jetlink_coreml.time.sleep", lambda _: None)
+  _wait_for_local_preload(client, marker)
+  assert client.state_calls == 2
+
+
+@pytest.mark.parametrize("marker_text, hello", [
+  (None, {}),
+  ("not json", {}),
+  ('{"sha256": "stock-sha"}', {"loaded": "stock-sha", "cached_models": ["stock-sha"]}),
+  ('{"sha256": "uncached-sha"}', {"loaded": None, "cached_models": []}),
+])
+def test_no_wait_without_valid_pending_preload(tmp_path, marker_text, hello):
+  marker = tmp_path / "last-loaded.json"
+  if marker_text is not None:
+    marker.write_text(marker_text)
+  client = PreloadClient(hello)
+  _wait_for_local_preload(client, marker)
+  assert client.state_calls == 0
+
+
+def test_preload_timeout_is_bounded(tmp_path, monkeypatch):
+  marker = tmp_path / "last-loaded.json"
+  marker.write_text(json.dumps({"sha256": "stock-sha"}))
+  client = PreloadClient({"loaded": None, "cached_models": ["stock-sha"]})
+  ticks = iter([0., 31.])
+  monkeypatch.setattr("openpilot.selfdrive.modeld.jetlink_coreml.time.monotonic", lambda: next(ticks))
+  with pytest.raises(RuntimeError, match="30 seconds"):
+    _wait_for_local_preload(client, marker)
